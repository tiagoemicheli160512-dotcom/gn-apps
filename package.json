{
  "name": "gn-apps",
  "version": "1.0.0",
  "description": "GN Apps - Desktop application with online auto-updates",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "concurrently \"npx react-scripts start\" \"wait-on http://localhost:3000 && electron .\"",
    "build:react": "react-scripts build",
    "build": "react-scripts build && electron-builder",
    "build:win": "react-scripts build && electron-builder --win",
    "build:mac": "react-scripts build && electron-builder --mac",
    "build:linux": "react-scripts build && electron-builder --linux",
    "publish": "react-scripts build && electron-builder --publish always",
    "publish:win": "react-scripts build && electron-builder --win --publish always",
    "publish:mac": "react-scripts build && electron-builder --mac --publish always",
    "publish:linux": "react-scripts build && electron-builder --linux --publish always"
  },
  "build": {
    "appId": "com.gn-apps.desktop",
    "productName": "GN Apps",
    "directories": {
      "output": "dist",
      "buildResources": "public"
    },
    "files": [
      "build/**/*",
      "src/main/**/*",
      "src/preload/**/*",
      "node_modules/**/*"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "tiagoemicheli160512-dotcom",
        "repo": "gn-apps",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": ["nsis"],
      "icon": "public/icon.png"
    },
    "mac": {
      "target": ["dmg"],
      "icon": "public/icon.png"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "icon": "public/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true
    }
  },
  "homepage": "./",
  "dependencies": {
    "electron-updater": "^6.3.9",
    "electron-log": "^5.2.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-scripts": "5.0.1"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "concurrently": "^9.1.2",
    "wait-on": "^8.0.1"
  },
  "browserslist": {
    "production": [
      "last 1 electron version"
    ],
    "development": [
      "last 1 electron version"
    ]
  }
}
